# ==============================================================================
# AuthSign Environment Variables Example
# Copy this file to .env.local and populate the values for local development
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Email Delivery
RESEND_API_KEY=re_123456789...
EMAIL_FROM=AuthSign <onboarding@resend.dev>

# Cryptographic Salt / Pepper for OTP challenges (min 32 chars)
OTP_PEPPER=authsign_super_secret_otp_pepper_minimum_32_characters_long_2026

# Public Application URL (used in email link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
